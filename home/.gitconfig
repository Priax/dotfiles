[user]
	name = Priax
	email = priax.xairp@gmail.com
[init]
	defaultBranch = main
[diff]
	tool = nvimdiff
[merge]
	tool = codediff
[mergetool "codediff"]
	cmd = nvim \"$MERGED\" -c \"CodeDiff --exit-on-close merge \\\"$MERGED\\\"\"
[mergetool]
	keepBackup = false
	prompt = false
# Réglages propres à la machine (git-lfs…), non suivis par dotfiles. Absent = ignoré.
[include]
	path = ~/.gitconfig.local
