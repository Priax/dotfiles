#!/usr/bin/env bash
# dot: gestion des dotfiles à partir de ./manifest
#
#   dot status    état de chaque fichier (machine vs repo)
#   dot diff [p]  diff détaillé, filtré sur p si donné
#   dot save      machine → repo, avec les listes de paquets, sans git
#   dot push      save, commit, git pull --rebase, git push
#   dot apply     repo → machine (l'existant est sauvegardé)
#   dot pull      git pull, puis apply
#   dot install   nouvelle machine: dépendances, apply, paquets
#   dot upgrade   met tout à jour: paquets, toolchains, outils, police, nvim
#   dot clean     retire paquets inutilisés et caches
#   dot defaults  macOS: réglages système de packages/macos/defaults.sh
#   dot tablette  Linux: compile et installe le correctif de la télécommande XP-Pen ACK05

set -euo pipefail

# mapfile demande bash 4, macOS fournit bash 3.2
((BASH_VERSINFO[0] >= 4)) || {
    echo "dot demande bash 4+ (sur Mac: brew install bash)" >&2
    exit 1
}

REPO_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
MANIFEST="$REPO_DIR/manifest"
BACKUP_DIR="$HOME/dotfiles_backup/$(date +%Y%m%d_%H%M%S)"
# vmlinux.h et *.bpf.o sont générés par « dot tablette »
EXCLUDES=('*.bak' '*.save' '*.swp' '.git' 'fish_variables' 'vmlinux.h' '*.bpf.o' '__pycache__')

case "$(uname -s)" in
    Darwin) OS=macos ;;
    *) OS=linux ;;
esac
PKG_DIR="$REPO_DIR/packages/$OS"

# shellcheck source=lib/common.sh
. "$REPO_DIR/lib/common.sh"
# shellcheck source=lib/sync.sh
. "$REPO_DIR/lib/sync.sh"
# shellcheck source=lib/packages.sh
. "$REPO_DIR/lib/packages.sh"
# shellcheck source=lib/install.sh
. "$REPO_DIR/lib/install.sh"
# shellcheck source=lib/nvim.sh
. "$REPO_DIR/lib/nvim.sh"
# shellcheck source=lib/upgrade.sh
. "$REPO_DIR/lib/upgrade.sh"
# shellcheck source=lib/clean.sh
. "$REPO_DIR/lib/clean.sh"

usage() {
    sed -n '2,14s/^# \{0,1\}//p' "${BASH_SOURCE[0]}"
    exit "${1:-0}"
}

main() {
    case "${1:-}" in
        status | st) cmd_status ;;
        diff) cmd_diff "${2:-}" ;;
        save) cmd_save ;;
        push) cmd_push ;;
        apply) cmd_apply ;;
        pull) cmd_pull ;;
        after-pull) cmd_after_pull ;; # interne, fin de dot pull
        install) cmd_install ;;
        upgrade) cmd_upgrade ;;
        clean) cmd_clean ;;
        defaults) cmd_defaults ;;
        tablette) cmd_tablette ;;
        -h | --help | help) usage ;;
        *) usage 1 ;;
    esac
    if ((${#FAILURES[@]})); then
        warn "Étapes en échec:"
        printf '%s\n' "${FAILURES[@]/#/  - }" >&2
        exit 1
    fi
}

# Tout sur une ligne, en fin de fichier: bash a lu tout le script avant de lancer main, et exit
# l'empêche de lire la suite. On peut donc modifier dot pendant qu'il tourne (dot pull).
main "$@"; exit
